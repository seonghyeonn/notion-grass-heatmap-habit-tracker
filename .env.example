# Required: Notion internal integration secret (Read content permission is enough)
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Recommended: comma-separated database IDs this deployment may read.
# Leave empty to allow every database shared with the integration.
ALLOWED_DATABASES=

# Optional: upper bound of rows read per request (protects the Notion rate limit)
MAX_ROWS=5000

# Optional defaults. Every URL option has one (DEFAULT_ + the option name in
# capitals, except db -> DEFAULT_DATABASE and tz -> DEFAULT_TIMEZONE).
# A value in the URL always wins. Leave a line empty to use the built-in default.
# With DEFAULT_DATABASE and DEFAULT_FORMAT=html set, the embed URL is just /api/heatmap
DEFAULT_DATABASE=
DEFAULT_FORMAT=
DEFAULT_TIMEZONE=UTC
DEFAULT_LOCALE=en
DEFAULT_THEME=github
DEFAULT_TITLE=
DEFAULT_WEEKS=
DEFAULT_WEEK_START=
DEFAULT_DATE=
DEFAULT_MODE=
# Several filters are separated with ;  e.g. Status:Done;Tag:!Archive
DEFAULT_FILTER=
DEFAULT_COLOR=
DEFAULT_BG=
DEFAULT_BORDER_COLOR=
DEFAULT_TITLE_COLOR=
DEFAULT_TEXT_COLOR=
DEFAULT_EMPTY_COLOR=
DEFAULT_HIDE_TITLE=
DEFAULT_HIDE_STATS=
DEFAULT_HIDE_LEGEND=
DEFAULT_HIDE_LABELS=
DEFAULT_HIDE_BORDER=
DEFAULT_CELL=
DEFAULT_GAP=
DEFAULT_RADIUS=
DEFAULT_CACHE_SECONDS=

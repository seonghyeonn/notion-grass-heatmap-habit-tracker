# Required: API token of a Notion connection (Developer tools > Connections > API token).
# Read content is the only capability needed.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: extra databases (comma-separated links or IDs) on top of DEFAULT_DATABASE.
# Empty + DEFAULT_DATABASE set  -> only DEFAULT_DATABASE can be read.
# Empty + no DEFAULT_DATABASE   -> any database shared with the connection.
# *                             -> any database shared with the connection.
ALLOWED_DATABASES=

# Optional: upper bound of rows read per request (protects the Notion rate limit)
MAX_ROWS=5000

# Optional defaults. Every URL option has one (DEFAULT_ + the option name in
# capitals, except db -> DEFAULT_DATABASE and tz -> DEFAULT_TIMEZONE).
# A value in the URL always wins. Leave a line empty to use the built-in default.
# With DEFAULT_DATABASE and DEFAULT_FORMAT=html set, the embed URL is just /api/heatmap
# DEFAULT_DATABASE takes ONE link or ID. It also locks the deployment to that
# database; put any others in ALLOWED_DATABASES and embed each with ?db=<link>.
DEFAULT_DATABASE=
DEFAULT_FORMAT=
DEFAULT_TIMEZONE=UTC
DEFAULT_LOCALE=en
DEFAULT_THEME=github
DEFAULT_TITLE=
DEFAULT_WEEKS=
DEFAULT_WEEK_START=
DEFAULT_DATE=
DEFAULT_MODE=
# Several filters are separated with ;  e.g. Status:Done;Tag:!Archive
DEFAULT_FILTER=
DEFAULT_COLOR=
DEFAULT_BG=
DEFAULT_BORDER_COLOR=
DEFAULT_TITLE_COLOR=
DEFAULT_TEXT_COLOR=
DEFAULT_EMPTY_COLOR=
DEFAULT_HIDE_TITLE=
DEFAULT_HIDE_STATS=
DEFAULT_HIDE_LEGEND=
DEFAULT_HIDE_LABELS=
DEFAULT_HIDE_BORDER=
DEFAULT_CELL=
DEFAULT_GAP=
DEFAULT_RADIUS=
DEFAULT_CACHE_SECONDS=
